# NVIDIA Build (OpenAI-compatible). Copy exact model IDs from build.nvidia.com
# Or a self-hosted server (e.g. the Spark): set LLM_BASE_URL to it and LLM_MODEL; no key needed.
NVIDIA_API_KEY=nvapi-...
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=<text model id>
# Vision model. Same base URL by default; point at a local server on the Spark for full privacy.
# Off unless VISION_BACKEND=nvidia is set: the default witness is Apple Vision, on the Mac.
# VISION_BACKEND=nvidia
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=<vision-language model id>

CAMERA_INDEX=0
SAMPLE_EVERY_S=60
MOTION_THRESHOLD=6.0

# Notifications: print | macos | telegram
NOTIFY=macos
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strava (P5)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

REPORT_HOUR=22
