<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.theultras.alibi.sync</string>
		<string>app.theultras.alibi.live</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Alibi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Alibi reads your activity, sleep, heart rate, mindful minutes, daylight, moods and workouts so it can check your habits. It only goes to the Alibi app on your own Mac.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Alibi never writes to Health.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Alibi sends your Health, motion and Focus updates to the Alibi app on your Mac.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Always, Alibi can notice when you leave or get home even while it's closed (for walk and gym habits, and away-from-desk checks). Only at home: yes/no is sent to your Mac.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Alibi saves your home as a small circle on this phone. Your Mac only ever learns at home: yes or no, never where you are.</string>
	<key>NSMotionUsageDescription</key>
	<string>Alibi notices whether you're still, walking or driving, and when you pick up your phone, so it can tell if a focus session really stayed focused.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
